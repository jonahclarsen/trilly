{
  "manifest_version": 3,
  "name": "Trilly Amazon",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "description": "Collect Amazon payment and order details for local Trilly review.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://www.amazon.ca/*", "https://amazon.ca/*", "https://www.amazon.com/*", "https://amazon.com/*", "https://m.media-amazon.com/*", "https://images-na.ssl-images-amazon.com/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {"matches": ["http://127.0.0.1/*", "http://localhost/*"], "js": ["bridge.js"], "run_at": "document_start"},
    {"matches": ["https://www.amazon.ca/*", "https://amazon.ca/*", "https://www.amazon.com/*", "https://amazon.com/*"], "js": ["parser.js", "collector.js"], "run_at": "document_start"}
  ],
  "action": {"default_title": "Start Amazon collection from Trilly"}
}
